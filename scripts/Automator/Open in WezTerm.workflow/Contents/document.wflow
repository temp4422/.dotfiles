				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>for item in "$@"; do
    if [[ -d "$item" ]]; then
        folder="$item"
    else
        folder="$(dirname "$item")"
    fi

    /Applications/WezTerm.app/Contents/MacOS/wezterm cli spawn --cwd "$folder"
done</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
					<key>source</key>
