{
  "title": "ALL SHORTCUTS",
  "description": "Abbreviations: 🔵 = is important; 🔴 = must overwrite important to work properly; super = right_command",
  "rules": [
    {
      "description": "🔴 iTerm2 Overwrite",
      "manipulators": [
        {
          "description": "iTerm2 cmd+shit+c set variable copyMode = 1",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2"]
            }
          ],
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": ["left_command", "left_shift"]
            }
          },
          "to": [
            {
              "key_code": "c",
              "modifiers": ["left_command", "left_shift"]
            },
            {
              "set_variable": {
                "name": "copyMode",
                "value": 1
              }
            }
          ],
          "type": "basic"
        },
        {
          "description": "iTerm2 if copyMode = 1; cmd+c -> y",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2"]
            },
            {
              "type": "variable_if",
              "name": "copyMode",
              "value": 1
            }
          ],
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": ["left_command"]
            }
          },
          "to": [
            {
              "key_code": "y"
            },
            {
              "set_variable": {
                "name": "copyMode",
                "value": 0
              }
            }
          ],
          "type": "basic"
        },
        {
          "description": "iTerm2 if copyMode = 1; Home -> 0 (Move to start of line)",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2"]
            },
            {
              "type": "variable_if",
              "name": "copyMode",
              "value": 1
            }
          ],
          "from": {
            "key_code": "m",
            "modifiers": {
              "mandatory": ["right_command"]
            }
          },
          "to": [
            {
              "key_code": "0"
            }
          ],
          "type": "basic"
        },
        {
          "description": "iTerm2 if copyMode = 1; End -> $ (Move to end of line)",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2"]
            },
            {
              "type": "variable_if",
              "name": "copyMode",
              "value": 1
            }
          ],
          "from": {
            "key_code": "slash",
            "modifiers": {
              "mandatory": ["right_command"]
            }
          },
          "to": [
            {
              "key_code": "4",
              "modifiers": ["left_shift"]
            }
          ],
          "type": "basic"
        },
        {
          "description": "iTerm2 if copyMode = 1; Home+Shift -> 0 (Select and Move to start of line)",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2"]
            },
            {
              "type": "variable_if",
              "name": "copyMode",
              "value": 1
            }
          ],
          "from": {
            "key_code": "m",
            "modifiers": {
              "mandatory": ["right_command", "left_shift"]
            }
          },
          "to": [
            {
              "key_code": "spacebar"
            },
            {
              "key_code": "0"
            }
          ],
          "type": "basic"
        },
        {
          "description": "iTerm2 if copyMode = 1; End+Shift -> $ (Select and Move to end of line)",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2"]
            },
            {
              "type": "variable_if",
              "name": "copyMode",
              "value": 1
            }
          ],
          "from": {
            "key_code": "slash",
            "modifiers": {
              "mandatory": ["right_command", "left_shift"]
            }
          },
          "to": [
            {
              "key_code": "spacebar"
            },
            {
              "key_code": "4",
              "modifiers": ["left_shift"]
            }
          ],
          "type": "basic"
        },
        {
          "description": "iTerm2 if copyMode = 1; Esc -> Esc+Esc (Exit and Reset)",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2"]
            },
            {
              "type": "variable_if",
              "name": "copyMode",
              "value": 1
            }
          ],
          "from": {
            "key_code": "caps_lock"
          },
          "to": [
            {
              "key_code": "escape"
            },
            {
              "key_code": "escape"
            }
          ],
          "type": "basic"
        },
        {
          "description": "iTerm2 disable cmd+shift+p",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2"]
            }
          ],
          "from": {
            "key_code": "p",
            "modifiers": {
              "mandatory": ["left_command", "left_shift"]
            }
          },
          "to": [{ "key_code": "vk_none" }],
          "type": "basic"
        },
        {
          "description": "iTerm2 map cmd+d to select word in copy mode",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2"]
            },
            {
              "type": "variable_if",
              "name": "copyMode",
              "value": 1
            }
          ],
          "from": {
            "key_code": "d",
            "modifiers": {
              "mandatory": ["left_command"]
            }
          },
          "to": [
            {
              "key_code": "right_arrow",
              "modifiers": ["left_option"]
            },
            {
              "key_code": "left_arrow",
              "modifiers": ["left_option"]
            },
            {
              "key_code": "spacebar"
            },
            {
              "key_code": "right_arrow",
              "modifiers": ["left_option"]
            }
          ],
          "type": "basic"
        },
        {
          "description": "Fix terminal home/end",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2", "com.github.wez.wezterm"]
            }
          ],
          "from": {
            "key_code": "m",
            "modifiers": {
              "mandatory": ["right_command"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "home"
            }
          ],
          "type": "basic"
        },
        {
          "description": "Fix terminal home/end",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.googlecode.iterm2", "com.github.wez.wezterm"]
            }
          ],
          "from": {
            "key_code": "slash",
            "modifiers": {
              "mandatory": ["right_command"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "end"
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
